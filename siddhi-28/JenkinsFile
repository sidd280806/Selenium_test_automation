pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code'
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Building project'
                dir('siddhi-28') {
                    bat 'mvn clean compile'
                }
            }
        }

        stage('Run Selenium Tests') {
            steps {
                dir('siddhi-28') {
                    bat 'mvn test'
                }
            }
        }
    }
}
